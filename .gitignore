# Per-project .gitignore files generated by `flutter create` cover most Dart and
# platform artefacts. This root file is the monorepo-wide backstop.

# ---- Rust ----
target/
**/*.rs.bk
# Cargo.lock is intentionally NOT ignored. muxdeckd is a binary, so the lockfile
# is committed to keep builds reproducible.

# ---- Dart / Flutter ----
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec_overrides.yaml
doc/api/

# FVM: the local SDK symlink is machine-specific, but .fvmrc pins the version
# for everyone and must stay tracked.
.fvm/

# ---- Flutter platform ephemerals ----
**/android/local.properties
**/android/.gradle/
**/android/captures/
**/android/key.properties
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework/
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/App.framework/
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*
**/windows/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/linux/flutter/ephemeral/

# ---- Editors ----
*.iml
.idea/
.vscode/
*.swp

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Secrets: CLAUDE.md constraint #5 ----
# Keys, certificates and tokens live in the OS config directory at runtime and
# have no business in this repository. protocol/fixtures/ may contain only
# obviously-fake test values.
*.pem
*.p12
*.pfx
identity.key
admin.token
devices.json
